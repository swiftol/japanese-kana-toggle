{
  "manifest_version": 3,
  "name": "日语假名开关",
  "version": "0.1.3",
  "description": "在指定网站点击日语显示读音，也可以切换整页显示。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "日语假名开关",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/dict/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
